# ⚙️ ENVIRONMENT VARIABLES
# Skopírujte tento súbor na .env a vyplňte vaše hodnoty

# 🔑 Stripe API Keys
# Získajte na: https://dashboard.stripe.com/apikeys

# Test mode (development)
STRIPE_SECRET_KEY=sk_test_51xxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_51xxxxxxxxxxxxx

# Production (po testovaní zmeňte na live keys)
# STRIPE_SECRET_KEY=sk_live_51xxxxxxxxxxxxx
# STRIPE_PUBLISHABLE_KEY=pk_live_51xxxxxxxxxxxxx

# 🔔 Webhook Secret
# Získajte po vytvorení webhooku v Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# 🌐 Server Configuration
PORT=3000
NODE_ENV=development

# 📧 Email Configuration (voliteľné - pre posielanie potvrdení)
# EMAIL_SERVICE=sendgrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxx
# FROM_EMAIL=faktury@vasafirma.sk

# 💾 Database (voliteľné - ak používate)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=invoices
# DB_USER=admin
# DB_PASSWORD=xxxxx

# 🔒 Security
# SESSION_SECRET=random_string_here_32_chars_min
# ALLOWED_ORIGINS=http://localhost:8000,https://vasafirma.sk
